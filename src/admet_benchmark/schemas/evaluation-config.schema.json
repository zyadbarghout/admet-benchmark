{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:admet-benchmark:schema:evaluation-config:1",
  "title": "ADMET prepared-prediction evaluation",
  "type": "object",
  "required": ["schema_version", "task", "predictions"],
  "properties": {
    "schema_version": {"const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "task": {"enum": ["regression", "classification"]},
    "output_dir": {"type": "string", "minLength": 1},
    "predictions": {
      "type": "object",
      "required": ["path", "columns"],
      "properties": {
        "path": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "columns": {"type": "object"},
        "defaults": {"type": "object"},
        "prediction_columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "uncertainty_columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "prediction_lower_columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "prediction_upper_columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "target_transform": {"$ref": "#/$defs/endpointSetting"},
    "thresholds": {"$ref": "#/$defs/endpointSetting"},
    "uncertainty": {
      "type": "object",
      "required": ["higher_is_more_uncertain", "scale"],
      "properties": {
        "higher_is_more_uncertain": {"const": true},
        "scale": {"const": "evaluation"},
        "interval_confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "endpointSetting": {
      "type": "object",
      "properties": {
        "default": {},
        "endpoints": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
