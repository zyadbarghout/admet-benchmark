{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "evidence_level": {
      "enum": [
        "screening",
        "development"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "source",
        "license"
      ]
    },
    "identity_policy": {
      "const": "rdkit_canonical_isomeric_v1"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "enum": [
              "regression",
              "classification"
            ]
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "transform": {
            "enum": [
              "none",
              "log10",
              "ln"
            ]
          },
          "primary_metric": {
            "enum": [
              "mae",
              "rmse",
              "r2",
              "spearman",
              "roc_auc",
              "pr_auc",
              "brier",
              "log_loss"
            ]
          },
          "practical_difference": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "name",
          "task",
          "units",
          "transform",
          "primary_metric",
          "practical_difference"
        ]
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "molecule",
            "scaffold"
          ]
        },
        "test_seed": {
          "type": "integer",
          "minimum": 0
        },
        "repeat_seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "test_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "validation_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "calibration_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "minimum_molecules": {
          "type": "integer",
          "minimum": 2
        },
        "minimum_per_class": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "strategy",
        "test_seed",
        "repeat_seeds",
        "test_fraction",
        "validation_fraction",
        "calibration_fraction",
        "minimum_molecules",
        "minimum_per_class"
      ]
    },
    "selection_policy": {
      "const": "fixed_models_no_tuning"
    },
    "test_policy": {
      "const": "locked_until_protocol_final"
    },
    "uq_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ensemble_disagreement",
          "split_conformal",
          "none"
        ]
      }
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compute_budget_cpu_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "evidence_level",
    "dataset",
    "identity_policy",
    "endpoints",
    "models",
    "split",
    "selection_policy",
    "test_policy",
    "uq_methods",
    "cohorts",
    "compute_budget_cpu_hours"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admet-benchmark.local/schemas/study-v1.json",
  "title": "Development study protocol v1"
}
